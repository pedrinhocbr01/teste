# Porta da API (demo em /demo.html)
PORT=3001

# Produção/docker: aponte para o Postgres real e a API usa ele (pool pg).
# Ex.: postgres://pdv:pdv@localhost:5433/pdv
# Vazio = modo dev com Postgres embutido (PGlite): carrega db/schema.sql + db/seed.sql na memória.
DATABASE_URL=

# Segredo do JWT — TROQUE em produção!
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=12h

# Opcional: persiste o banco dev (PGlite) em disco em vez de memória.
# PGLITE_DIR=./.pglite
