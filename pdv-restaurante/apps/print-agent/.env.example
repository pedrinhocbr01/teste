# URL da API (na LAN do restaurante: IP do mini-PC, ex. http://192.168.15.10:3001)
API_URL=http://localhost:3001

# Login do agente (use um usuário dedicado! crie via POST /usuarios, papel GERENTE ou ADMIN)
AGENT_EMAIL=diego@casadofogo.com
AGENT_PIN=5555

# MODO=virtual (dev: salva tickets/*.txt, não precisa impressora) | real (TCP :9100)
MODO=virtual
TICKETS_DIR=./tickets

# Intervalo do polling (o WS acorda o agente na hora; polling é o fallback)
POLL_MS=3000

# Opcional: este agente atende só estas estações (ids). Vazio = todas.
# Ex.: ESTACAO_IDS=1  (um agente por impressora, cada um no PC da estação)
ESTACAO_IDS=

# Bipe ao imprimir (BEL — Epson/Elgin/Bematech obedecem)
BEEP=true

# Desiste de re-tentar FALHA após N tentativas (precisa reimpressão manual)
MAX_TENTATIVAS=50
