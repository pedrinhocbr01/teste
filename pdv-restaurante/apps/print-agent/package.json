{
  "name": "@pdv/print-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Print agent local do PDV: consome impressao_log e imprime ESC/POS nas térmicas da LAN",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:dev": "ts-node --transpile-only src/index.ts",
    "test": "npm run build && node --test test/renderer.test.mjs",
    "test:e2e": "npm run build && node test/e2e.mjs"
  },
  "dependencies": {
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3"
  }
}
